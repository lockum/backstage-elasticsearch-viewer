{
  "name": "backstage-opensearch-plugins-root",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "plugins/*"
  ],
  "scripts": {
    "build": "yarn workspaces foreach --all run build",
    "test": "node scripts/run-all-tests.mjs",
    "test:backend": "yarn workspace @lockum/opensearch-plugin-backend test",
    "test:frontend": "yarn workspace @lockum/opensearch-plugin test",
    "clean": "rm -rf dist dist-types node_modules plugins/*/dist plugins/*/dist-types"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
